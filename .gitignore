# =============================================================================
# .gitignore for np-profiling
# =============================================================================

# Always track .gitkeep placeholder files (used to preserve empty directories)
!**/.gitkeep

# --- Large data files (tracked via Git LFS or kept via .gitkeep) ---
data/db/*
!data/db/.gitkeep
# data/output/ files are now stored in LFS — see .gitattributes
data/input/training/*
!data/input/training/.gitkeep
data/input/training/*.parquet
data/input/*
!data/input/.gitkeep

# --- Trained model outputs (tracked via Git LFS) ---
# results/ files are now stored in LFS — see .gitattributes

# --- DrugBank database snapshot (required input — tracked in repo) ---
# drugbank/ is intentionally tracked; db_all.Rds is 67 MB (under GitHub's 100 MB limit)

# --- Editor artifacts ---
.vscode/

# --- R session artifacts ---
.Rhistory
.RData
.Rproj.user/
*.Rproj

# --- Agent configuration (local only) ---
.agents/

# --- OS artifacts ---
.DS_Store
Thumbs.db
desktop.ini

# --- Large LFS-tracked files removed from repo to save LFS quota (regenerate via scripts) ---
results/RF_target.Rds
results/RF_target_cutoffRefined_roc.Rds
data/output/dba_summary.Rds
data/output/masterdata.tsv
assays/nuclei_identification/analyzed/CP_PharmakonNuclei.csv
assays/nuclei_identification/analyzed/CP_PharmakonH2AX_fluor.csv
assays/nuclei_identification/analyzed/CP_PharmakonMatchedNuclei.csv
assays/nuclei_identification/analyzed/CP_PharmakonMatchedH2AX.csv
